{
  "expo": {
    "name": "GFF",
    "slug": "gluten-free-finder",
    "scheme": "gff",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/gff-logo.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#C9922A",
    "splash": {
      "image": "./assets/gff-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6EFE2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "online.glutenfreefinder.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "GFF fills your Australian postcode only when you tap the postcode field."
      }
    },
    "android": {
      "package": "online.glutenfreefinder.app",
      "adaptiveIcon": {
        "backgroundColor": "#F6EFE2",
        "foregroundImage": "./assets/gff-logo.png"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/gff-logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GFF fills your Australian postcode only when you tap the postcode field."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/gff-logo.png",
          "color": "#C9922A"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "replace-after-eas-init"
      }
    },
    "owner": "hellrazor777"
  }
}
