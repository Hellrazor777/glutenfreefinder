{
  "name": "glutenfreefinder",
  "version": "0.1.0",
  "private": true,
  "description": "GlutenFreeFinder - discover gluten-free friendly places to eat",
  "workspaces": [
    "api",
    "collector",
    "web"
  ],
  "scripts": {
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "start:collector": "npm run start -w collector",
    "test": "npm run test -w api",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
